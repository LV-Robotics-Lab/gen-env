diff --git a/scripts/pipeline/A_reconstruction/run.sh b/scripts/pipeline/A_reconstruction/run.sh
index 66f431e..64e320e 100755
--- a/scripts/pipeline/A_reconstruction/run.sh
+++ b/scripts/pipeline/A_reconstruction/run.sh
@@ -293,0 +294,15 @@ fi
+hydra_scalar() {
+  local value="$1"
+  if [[ "${value}" == *$'\n'* || "${value}" == *$'\r'* ]]; then
+    echo "Hydra override values cannot contain newlines." >&2
+    return 2
+  fi
+  if [[ "${value}" =~ ^[A-Za-z0-9_./:=-]+$ ]]; then
+    printf '%s' "${value}"
+    return
+  fi
+  value="${value//\\/\\\\}"
+  value="${value//\'/\\\'}"
+  printf "'%s'" "${value}"
+}
+
@@ -295,2 +310,2 @@ CMD+=(
-  "root_dir=${ROOT_DIR}"
-  "scene_name=${SCENE_NAME}"
+  "root_dir=$(hydra_scalar "${ROOT_DIR}")"
+  "scene_name=$(hydra_scalar "${SCENE_NAME}")"
@@ -300 +315 @@ if [[ "${INPUT_MODE}" == "video" ]]; then
-  CMD+=("s1_video.video_fpath=${VIDEO_FPATH}")
+  CMD+=("s1_video.video_fpath=$(hydra_scalar "${VIDEO_FPATH}")")
