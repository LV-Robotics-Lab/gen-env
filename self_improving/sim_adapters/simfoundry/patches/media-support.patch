diff --git a/tests/test_run_all_wrapper.py b/tests/test_run_all_wrapper.py
index ed5a294..92a546c 100644
--- a/tests/test_run_all_wrapper.py
+++ b/tests/test_run_all_wrapper.py
@@ -94,0 +95,40 @@ def test_run_all_forwards_nerfstudio_environment(tmp_path):
+
+
+def test_run_all_quotes_unicode_hydra_paths(tmp_path):
+    repo_root = Path(__file__).resolve().parents[1]
+    probe = tmp_path / "probe_python"
+    probe.write_text(
+        "#!/usr/bin/env bash\n"
+        "printf '%s\\n' \"$@\"\n",
+        encoding="utf-8",
+    )
+    probe.chmod(0o755)
+    output_root = tmp_path / "鼠标_单图"
+    video = output_root / "输入.png"
+
+    result = subprocess.run(
+        [
+            str(repo_root / "scripts" / "pipeline" / "A_reconstruction" / "run.sh"),
+            "--python-bin",
+            str(probe),
+            "--exec-mode",
+            "direct",
+            "--no-stream",
+            "--include",
+            "1b",
+            "--root-dir",
+            str(output_root),
+            "--scene-name",
+            "重建",
+            "--video-fpath",
+            str(video),
+        ],
+        cwd=repo_root,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    forwarded = result.stdout.splitlines()
+    assert f"root_dir='{output_root}'" in forwarded
+    assert "scene_name='重建'" in forwarded
+    assert f"s1_video.video_fpath='{video}'" in forwarded
