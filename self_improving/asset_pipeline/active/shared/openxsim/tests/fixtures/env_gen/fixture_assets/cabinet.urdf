<?xml version="1.0"?>
<robot name="cabinet_fixture">
  <material name="cabinet_gray">
    <color rgba="0.34 0.37 0.42 1"/>
  </material>
  <material name="drawer_blue">
    <color rgba="0.18 0.36 0.62 1"/>
  </material>

  <link name="base">
    <visual>
      <origin xyz="0 0.807 0"/>
      <geometry>
        <box size="0.899 1.614 0.854"/>
      </geometry>
      <material name="cabinet_gray"/>
    </visual>
  </link>

  <link name="drawer_1">
    <visual>
      <origin xyz="0 0 -0.48"/>
      <geometry>
        <box size="0.75 0.40 0.08"/>
      </geometry>
      <material name="drawer_blue"/>
    </visual>
  </link>
  <joint name="joint_1" type="prismatic">
    <parent link="base"/>
    <child link="drawer_1"/>
    <origin xyz="0 0.30 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="0.25" effort="100" velocity="1"/>
  </joint>

  <link name="drawer_2">
    <visual>
      <origin xyz="0 0 -0.48"/>
      <geometry>
        <box size="0.75 0.40 0.08"/>
      </geometry>
      <material name="drawer_blue"/>
    </visual>
  </link>
  <joint name="joint_2" type="prismatic">
    <parent link="base"/>
    <child link="drawer_2"/>
    <origin xyz="0 0.807 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="0.25" effort="100" velocity="1"/>
  </joint>

  <link name="drawer_3">
    <visual>
      <origin xyz="0 0 -0.48"/>
      <geometry>
        <box size="0.75 0.40 0.08"/>
      </geometry>
      <material name="drawer_blue"/>
    </visual>
  </link>
  <joint name="joint_3" type="prismatic">
    <parent link="base"/>
    <child link="drawer_3"/>
    <origin xyz="0 1.314 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="0.25" effort="100" velocity="1"/>
  </joint>
</robot>
